<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ruri-v3-310m 埋め込みサービス (Mac mini)

  設置:
    cp macmini/local.idea-memo.embed.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/local.idea-memo.embed.plist
    launchctl list | grep idea-memo

  USERNAME は自分のものに置換すること。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.idea-memo.embed</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>--</string>
    <string>uvicorn</string>
    <string>embed_server:app</string>
    <string>--host</string>
    <string>0.0.0.0</string>
    <string>--port</string>
    <string>7997</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/USERNAME/idea-memo/macmini</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>RURI_MODEL</key>
    <string>cl-nagoya/ruri-v3-310m</string>
    <key>RURI_MAX_SEQ_LEN</key>
    <string>1024</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- Background にすると I/O と CPU が絞られて応答が鈍る -->
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>/Users/USERNAME/idea-memo/logs/embed.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/idea-memo/logs/embed.err.log</string>
</dict>
</plist>
