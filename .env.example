# ---- Telegram ----------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABC...
ALLOWED_CHAT_ID=123456789

# ---- 埋め込み / 文字起こし ------------------------------------------
# コンテナ内では .local が引けないため、compose の extra_hosts で解決する。
# Mac mini はルーターで DHCP 予約するか固定 IP にしておく
MAC_MINI_IP=192.168.1.50
EMBED_URL=http://mac-mini.local:7997/embed
TRANSCRIBE_URL=http://mac-mini.local:7998/transcribe
# 完全 Docker 案ならこちら (compose のサービス名で解決する)
# EMBED_URL=http://embed:7997/embed

# ---- LLM (Docker 対象外。Ollama / vLLM の OpenAI 互換 API) -------------
# Mac-mini-M4Pro の Ollama を使う場合（例）:
# LLM_BASE_URL=http://192.168.1.102:11434/v1
# LLM_MODEL=qwen2.5:7b
# DGX Spark の vLLM に戻す場合は、下記2行に戻してワーカーを再起動する。
LLM_BASE_URL=http://gpu-node:8000/v1
LLM_MODEL=deepseek-v4-flash

# ---- 検索 --------------------------------------------------------
SEARCH_BACKEND=brave
BRAVE_API_KEY=
# SEARCH_BACKEND=searxng
# SEARXNG_URL=http://searxng:8080

# ---- チューニング ---------------------------------------------------
SUPERVISOR_INTERVAL=60
SIM_THRESHOLD=0.82
MIN_CLUSTER_SIZE=3
MIN_SAMPLES=2
INHERIT_THRESHOLD=0.4
